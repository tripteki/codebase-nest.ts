{{> mail.open}}
<p style="margin:0 0 6px;font-size:20px;font-weight:700;line-height:1.25;letter-spacing:-0.02em;color:#f9fafb;">{{ title }}</p>
<p style="margin:0 0 12px;font-size:15px;font-weight:700;line-height:1.55;color:#f3f4f6;">{{ start_greeting }}</p>
<p style="margin:0 0 12px;color:#d1d5db;font-size:14px;line-height:1.55;">{{ line1 }}</p>
{{#if line2}}
<p style="margin:0 0 12px;color:#9ca3af;font-size:12px;line-height:1.5;">{{ line2 }}</p>
{{/if}}
{{#if link}}
<table role="presentation" class="mail-cta" width="100%" cellpadding="0" cellspacing="0" align="center" style="margin:12px 0 10px;">
    <tr>
        <td align="center">
            <a class="mail-btn" href="{{ link }}" style="display:inline-block;min-width:180px;border-radius:8px;padding:11px 22px;font-size:13px;font-weight:700;letter-spacing:0.01em;text-align:center;color:#ffffff;background:{{ primary_color }};text-decoration:none;">{{ link_label }}</a>
        </td>
    </tr>
</table>
{{/if}}
{{> mail.sign thanks=mail_thanks}}
{{> mail.close}}
